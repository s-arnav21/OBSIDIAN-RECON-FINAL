# Database
DATABASE_URL=postgresql://obsidian:obsidian_password@postgres:5432/obsidian_recon

# Redis
REDIS_URL=redis://redis:6379/0

# Claude API
CLAUDE_API_KEY=your_key_here

# App
ENVIRONMENT=development

AI_API_KEY=your_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash

# Temporary local test harness. The browser cannot override this mode.
TEST_HARNESS_MODE=fixture
TEST_HARNESS_ALLOWED_ORIGINS=
# Development/test only. Production default must remain false.
ENABLE_DEV_DNS_BYPASS=false

# Replaceable DVWA development-lab adapter (required only in local_lab mode)
DVWA_BASE_URL=http://127.0.0.1:8080
DVWA_USERNAME=
DVWA_PASSWORD=
DVWA_TIMEOUT_SECONDS=10

# Optional synchronous reconnaissance adapters. Leave paths empty to disable.
# External HTTPS origins require persisted DNS TXT ownership verification.
RECON_NMAP_PATH=
RECON_NUCLEI_PATH=

# Optional provider-independent Agent Layer 2 planner.
# Keep the API key empty here; configure the real value only in your local .env.
# NOTE: the required trained Obsidian Recon model will be published after
# training completes; set AGENT_LLM_MODEL to that released version then.
AGENT_LLM_BASE_URL=http://10.57.68.248:11434
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-oss-120b
AGENT_LLM_TIMEOUT=15

# Agent bounded-run cap (max steps per run, default 10).
AGENT_MAX_STEPS=10

# Nuclei scanner tuning.  Defaults are conservative to avoid rate-limiting
# real targets; increase only when the target allows higher concurrency.
NUCLEI_CONCURRENCY=20
NUCLEI_RATE_LIMIT=50

# API key authentication (opt-in).  When set, all mutating API endpoints
# (POST/PUT/PATCH/DELETE) require ``X-API-Key: <token>``.
# Keep empty in development so local tools work without credentials.
API_AUTH_TOKEN=

# ── Optional web-testing / exploitation integrations ────────────────────────
# OWASP ZAP REST API. Empty ZAP_BASE_URL means "no ZAP" (adapter reports
# unavailable instead of guessing a host).
ZAP_BASE_URL=
ZAP_API_KEY=
ZAP_TIMEOUT=15

# Metasploit RPC (pymetasploit3 -> msfrpcd). Disabled unless enabled AND the
# optional package is importable. When enabled, the metasploit-* agent tools
# drive msfrpcd instead of shelling out to msfconsole.
MSF_RPC_ENABLED=false
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55552
MSF_RPC_USER=msf
MSF_RPC_PASSWORD=
MSF_RPC_SSL=false

# Automation (MITRE technique scripts): per-script budget, bounded artifact dir,
# and whether post-exploitation enumerators (LinPEAS/WinPEAS/LSE/pspy) may be
# fetched from the internet (default false: use the local cache only, resolved
# from /root/.local/share/recon, /usr/local/share/recon, /opt/recon).
AUTOMATION_TIMEOUT=180
AUTOMATION_ARTIFACT_DIR=
AUTOMATION_ALLOW_REMOTE_FETCH=false
