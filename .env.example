# Database
DATABASE_URL=postgresql://obsidian:obsidian_password@postgres:5432/obsidian_recon

# Redis
REDIS_URL=redis://redis:6379/0

# Claude API
CLAUDE_API_KEY=your_key_here

# App
ENVIRONMENT=development

AI_API_KEY=your_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash

# Temporary local test harness. The browser cannot override this mode.
TEST_HARNESS_MODE=fixture
TEST_HARNESS_ALLOWED_ORIGINS=
# Development/test only. Production default must remain false.
ENABLE_DEV_DNS_BYPASS=false

# Replaceable DVWA development-lab adapter (required only in local_lab mode)
DVWA_BASE_URL=http://127.0.0.1:8080
DVWA_USERNAME=
DVWA_PASSWORD=
DVWA_TIMEOUT_SECONDS=10

# Optional synchronous reconnaissance adapters. Leave paths empty to disable.
# External HTTPS origins require persisted DNS TXT ownership verification.
RECON_NMAP_PATH=
RECON_NUCLEI_PATH=

# Optional provider-independent Agent Layer 2 planner.
# Keep the API key empty here; configure the real value only in your local .env.
# NOTE: the required trained Obsidian Recon model will be published after
# training completes; set AGENT_LLM_MODEL to that released version then.
AGENT_LLM_BASE_URL=http://127.0.0.1:3001/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-oss-120b
AGENT_LLM_TIMEOUT=15
